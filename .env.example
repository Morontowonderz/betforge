# BETFORGE — environment variables (all have safe defaults; leave blank for mock/paper-only).
# Copy to .env. Run the backend with:  uvicorn betforge.api:app --port 8000

# SQLite training store (created by scripts/seed_historical.py). Relative to CWD.
BETFORGE_DB=betforge.db

# ---- responsible-use / paper-only policy (enforced at runtime) ----
BETFORGE_BANKROLL_NGN=100000
BETFORGE_STAKE_CAP_FRAC=0.01
BETFORGE_HARD_MAX_STAKE_FRAC=0.05
BETFORGE_DAILY_LOSS_CAP_NGN=20000
BETFORGE_STAKE_PLAN=flat
BETFORGE_EDGE_THRESHOLD_PCT=5.0
BETFORGE_AUTO_PAPER_TRADE=1

# ---- data sources (mock fallback used when blank — no keys required) ----
# API-Football / football-data.org (fixtures + historical results)
API_FOOTBALL_KEY=
FOOTBALL_DATA_KEY=
# SportyBet odds scraper config (optional; mock odds generator used otherwise)
SPORTYBET_SCRAPER_ENABLED=0

# ---- alert channels (mock adapters log to console + DB when blank) ----
TERMII_API_KEY=
TERMII_TO=
TERMII_FROM=BetForge
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
RESEND_API_KEY=
RESEND_TO=
RESEND_FROM=betforge@shadowspark.tech

# ---- frontend ----
# Point the dashboard's server-side fetches at the FastAPI backend.
BETFORGE_API_URL=http://127.0.0.1:8000

# ---- Minute-7 live corpus (optional; blank = seeded mock) ----
LIVE_MINUTE7_URL=
LIVE_MINUTE7_FILE=
